# Preserve approved owner artifacts and hash-bound step 7 evidence byte-for-byte.
docs/mcp/*.json -text

# Preserve upstream distributions byte-for-byte on Windows, including notices.
# Their generated shaders and underlined license headings are not project style.
src/local_asset_library/ui/vendor/** -text linguist-vendored whitespace=-trailing-space conflict-marker-size=32
src/local_asset_library/ui/vendor/README.md text linguist-vendored=false
src/local_asset_library/ui/vendor/manifest.json text linguist-vendored=false

# Built React bundle (frontend/ → npm run build): byte-for-byte, collapsed in diffs.
src/local_asset_library/ui/build/** -text -diff linguist-generated=true


# Release fixtures are frozen as their release wrote them (tests/test_release_fixtures.py).
tests/fixtures/releases/** -text -diff

# Shell wrappers run on Linux: never check them out with CRLF.
*.sh text eol=lf
